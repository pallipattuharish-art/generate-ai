# AI Study Assistant Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# AI Provider Configuration
# Supported providers: "gemini" (recommended, free tier available), "openai", or "demo"
AI_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Alternative: https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Max Upload Size in Megabytes (default: 16MB)
MAX_CONTENT_LENGTH_MB=16

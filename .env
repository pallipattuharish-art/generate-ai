# AI Study Assistant Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=study-assistant-local-secret-key-38291

# AI Provider Configuration: "gemini", "openai", or "demo"
# By default, "gemini" is selected. If GEMINI_API_KEY is left empty, the application
# gracefully falls back to interactive Demo Mode with clear banners.
AI_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Optional alternative: https://platform.openai.com/)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Max Upload Size in Megabytes
MAX_CONTENT_LENGTH_MB=16
